.panel {
    justify-content: space-evenly;
    align-items: center;
    background-color: rgb(31, 31, 31);
}

.menu {
    background-color: rgb(43, 43, 43);
    background-size: 100px 100px;
    flex-grow: 0;
    width: 1600px;
    height: 900px;
    flex-direction: column;
    align-items: stretch;
}

.unity-button {
    flex-grow: 0.1;
    align-items: stretch;
    justify-content: flex-start;
    align-content: auto;
    flex-direction: column;
    flex-wrap: nowrap;
    margin-top: 19px;
    translate: 1161px -70px;
    background-color: rgb(72, 72, 72);
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-color: rgb(99, 99, 99);
    border-right-color: rgb(99, 99, 99);
    border-bottom-color: rgb(99, 99, 99);
    border-left-color: rgb(99, 99, 99);
    margin-right: 50px;
    margin-left: 50px;
    -unity-font-definition: url("project://database/Assets/Fonts/munro-small.ttf?fileID=12800000&guid=b6db1521497d36546be41a6c0a53da86&type=3#munro-small");
    font-size: 50px;
    width: 322px;
}

.unity-button:hover {
    background-color: rgb(52, 120, 147);
    scale: 1.15 1.1;
    transition-property: scale;
    transition-duration: 0.2s;
}

.unity-button:hover:active {
    background-color: rgb(52, 120, 147);
    scale: 0.95 0.9;
    transition-property: scale;
    transition-duration: 0.2s;
}

.hide {
    visibility: hidden;
    display: none;
}

.insideMenu {
    width: 5000px;
    background-color: rgb(255, 0, 0);
}

.unity-slider {
    color: rgb(255, 255, 255);
    font-size: 65px;
}
