.panel {
    justify-content: space-evenly;
    align-items: center;
    background-color: rgb(31, 31, 31);
}

.menu {
    background-color: rgb(43, 43, 43);
    background-size: 100px 100px;
    flex-grow: 0;
    width: 1600px;
    height: 900px;
    flex-direction: column;
    align-items: stretch;
}

.unity-button {
    flex-grow: 0.1;
    align-items: stretch;
    justify-content: flex-start;
    align-content: auto;
    flex-direction: column;
    flex-wrap: nowrap;
    margin-top: 19px;
    translate: 1156px -125px;
    background-color: rgb(72, 72, 72);
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-color: rgb(99, 99, 99);
    border-right-color: rgb(99, 99, 99);
    border-bottom-color: rgb(99, 99, 99);
    border-left-color: rgb(99, 99, 99);
    margin-right: 50px;
    margin-left: 50px;
    -unity-font-definition: url("project://database/Assets/Fonts/munro-small.ttf?fileID=12800000&guid=b6db1521497d36546be41a6c0a53da86&type=3#munro-small");
    font-size: 50px;
    width: 352px;
    height: 106px;
}

.hide {
    visibility: hidden;
    display: none;
}

.insideMenu {
    width: 5000px;
    background-color: rgb(255, 0, 0);
}

.unity-slider {
    color: rgb(255, 255, 255);
    font-size: 65px;
}

#HighQuality:hover {
    scale: 1.1 1.1;
    background-color: rgb(224, 71, 71);
    transition-property: scale;
    transition-duration: 0.1s;
    border-left-color: rgb(144, 51, 51);
    border-right-color: rgb(144, 51, 51);
    border-top-color: rgb(144, 51, 51);
    border-bottom-color: rgb(144, 51, 51);
}

#MedQuality:hover {
    background-color: rgb(214, 140, 76);
    transition-property: scale;
    transition-duration: 0.1s;
    scale: 1.1 1.1;
    border-left-color: rgb(161, 100, 65);
    border-right-color: rgb(161, 100, 65);
    border-top-color: rgb(161, 100, 65);
    border-bottom-color: rgb(161, 100, 65);
}

#LowQuality:hover {
    background-color: rgb(68, 178, 76);
    transition-property: scale;
    transition-duration: 0.1s;
    scale: 1.1 1.1;
    border-left-color: rgb(53, 142, 45);
    border-right-color: rgb(53, 142, 45);
    border-top-color: rgb(53, 142, 45);
    border-bottom-color: rgb(53, 142, 45);
}

#HighQuality:hover:active {
    scale: 0.9 0.9;
    background-color: rgb(224, 71, 71);
    transition-property: scale;
    transition-duration: 0.1s;
    border-left-color: rgb(144, 51, 51);
    border-right-color: rgb(144, 51, 51);
    border-top-color: rgb(144, 51, 51);
    border-bottom-color: rgb(144, 51, 51);
}

#MedQuality:hover:active {
    scale: 0.9 0.9;
    background-color: rgb(214, 140, 76);
    transition-property: scale;
    transition-duration: 0.1s;
    border-left-color: rgb(161, 100, 65);
    border-right-color: rgb(161, 100, 65);
    border-top-color: rgb(161, 100, 65);
    border-bottom-color: rgb(161, 100, 65);
}

#LowQuality:hover:active {
    scale: 0.9 0.9;
    background-color: rgb(68, 178, 76);
    transition-property: scale;
    transition-duration: 0.1s;
    border-left-color: rgb(53, 142, 45);
    border-right-color: rgb(53, 142, 45);
    border-top-color: rgb(53, 142, 45);
    border-bottom-color: rgb(53, 142, 45);
}
